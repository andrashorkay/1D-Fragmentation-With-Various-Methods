# Material properties
density = 3900
E = 370e9

# Reference fracture properties
strength = 262e6
toughness = 50

# Bar geometry
length = 0.005
area = 1e-6

# Peridynamic discretisation
dx = 1e-5
horizon = 5.015e-5

# Bond model
bond_law = bilinear
bond_shape = conical

# Loading
strain_rate = 1e5

# Time integration
time_step_factor = 0.1
max_time = 1e-6

# Fragment convergence
enable_early_stopping = false
check_frequency = 100
stable_steps = 10

# Output
dump_freq = 100
output_dir = ../data/PD
diagnostics_file = results.out
fragment_file = fragments.out